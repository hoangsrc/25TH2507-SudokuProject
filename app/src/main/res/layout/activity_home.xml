<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SUDOKU"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginBottom="40dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardEasy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dễ (Easy)"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2563EB" />
            <TextView
                android:id="@+id/tvBestEasy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kỷ lục: --:--"
                android:textSize="13sp"
                android:textColor="#64748B" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trung bình (Medium)"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#16A34A" />
            <TextView
                android:id="@+id/tvBestMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kỷ lục: --:--"
                android:textSize="13sp"
                android:textColor="#64748B" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardHard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khó (Hard)"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#D97706" />
            <TextView
                android:id="@+id/tvBestHard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kỷ lục: --:--"
                android:textSize="13sp"
                android:textColor="#64748B" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardExpert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chuyên gia (Expert)"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#DC2626" />
            <TextView
                android:id="@+id/tvBestExpert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kỷ lục: --:--"
                android:textSize="13sp"
                android:textColor="#64748B" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>